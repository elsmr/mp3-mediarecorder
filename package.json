{
    "name": "mp3-mediarecorder",
    "version": "4.0.5",
    "description": "MediaRecorder ponyfill that records audio as mp3",
    "keywords": [
        "audio",
        "encode",
        "encoding",
        "libmp3lame",
        "mediarecorder",
        "mediastream",
        "mp3",
        "polyfill",
        "ponyfill",
        "record",
        "vmsg",
        "webassembly"
    ],
    "homepage": "https://github.com/elsmr/mp3-mediarecorder#readme",
    "bugs": {
        "url": "https://github.com/elsmr/mp3-mediarecorder/issues"
    },
    "license": "MIT",
    "author": "Elias Meire",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/elsmr/mp3-mediarecorder.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./worker": {
            "types": "./dist/worker.d.ts",
            "default": "./dist/worker.js"
        },
        "./vmsg.wasm": "./dist/vmsg.wasm",
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "rm -rf dist && bun build src/index.ts src/worker.ts --root src --outdir dist --target browser && tsc -p tsconfig.build.json && cp node_modules/vmsg/vmsg.wasm dist/",
        "test": "bun test",
        "tsc": "tsc",
        "lint": "oxlint",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "size": "size-limit",
        "dev": "vite examples/basic --config vite.config.ts",
        "vercel-build": "vite build examples/basic --config vite.config.ts --outDir ../../public --emptyOutDir",
        "release": "bun run build && changeset publish"
    },
    "dependencies": {
        "vmsg": "0.4.0"
    },
    "devDependencies": {
        "@changesets/cli": "3.0.3",
        "@size-limit/file": "14.0.0",
        "@types/bun": "1.4.2",
        "oxfmt": "0.68.0",
        "oxlint": "1.83.0",
        "size-limit": "14.0.0",
        "typescript": "7.0.2",
        "vite": "8.3.0"
    },
    "size-limit": [
        {
            "path": "dist/index.js",
            "limit": "2 kB"
        },
        {
            "path": "dist/worker.js",
            "limit": "1.5 kB"
        }
    ],
    "packageManager": "bun@1.4.2"
}
