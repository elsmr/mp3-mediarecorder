{
    "name": "mp3-mediarecorder",
    "version": "4.0.5",
    "description": "MediaRecorder ponyfill that records audio as mp3",
    "keywords": [
        "audio",
        "encode",
        "encoding",
        "lame",
        "libmp3lame",
        "mediarecorder",
        "mediastream",
        "mp3",
        "polyfill",
        "ponyfill",
        "record",
        "webassembly"
    ],
    "homepage": "https://github.com/elsmr/mp3-mediarecorder#readme",
    "bugs": {
        "url": "https://github.com/elsmr/mp3-mediarecorder/issues"
    },
    "license": "MIT",
    "author": "Elias Meire",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/elsmr/mp3-mediarecorder.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./worker": {
            "types": "./dist/worker.d.ts",
            "default": "./dist/worker.js"
        },
        "./mp3.wasm": "./dist/mp3.wasm",
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "rm -rf dist && bun build src/index.ts src/worker.ts --root src --outdir dist --target browser && tsc -p tsconfig.build.json && cp src/mp3.wasm dist/",
        "test": "bun test src",
        "tsc": "tsc",
        "lint": "oxlint",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "size": "size-limit",
        "dev": "vite examples/basic --config vite.config.ts",
        "vercel-build": "vite build examples/basic --config vite.config.ts --outDir ../../public --emptyOutDir",
        "release": "bun run build && changeset publish",
        "test:e2e": "bun test e2e"
    },
    "devDependencies": {
        "@changesets/cli": "3.0.3",
        "@size-limit/file": "14.0.0",
        "@types/bun": "1.4.2",
        "oxfmt": "0.68.0",
        "oxlint": "1.83.0",
        "playwright": "1.63.0",
        "size-limit": "14.0.0",
        "typescript": "7.0.2",
        "vite": "8.3.0"
    },
    "size-limit": [
        {
            "path": "dist/index.js",
            "limit": "3.5 kB"
        },
        {
            "path": "dist/worker.js",
            "limit": "2.5 kB"
        },
        {
            "path": "dist/mp3.wasm",
            "limit": "85 kB",
            "brotli": false
        }
    ],
    "packageManager": "bun@1.4.2"
}
